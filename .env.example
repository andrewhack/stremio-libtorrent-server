# The variables the compose files read. Copy this file to .env (which git ignores) and fill in what
# you need; docker compose reads .env from this directory by itself. Leave a line empty to keep its
# default.

# --- compose.yaml, compose.hub.yaml ------------------------------------------------------------

# Your server's LAN IP, for a trusted certificate that TVs and the desktop app accept (from
# Stremio's certificate service). Empty: a certificate of your own in the data directory, or a
# self-signed one.
IPADDRESS=

# The address the bundled web player talks to. Set automatically from IPADDRESS when that is set.
SERVER_URL=

# BitTorrent peer port, inbound TCP and UDP. The published port follows it. Default 6881.
STREMIOSRV_BT_LISTEN_PORT=

# A host directory for the cache and the certificate (compose.yaml). Default: a named volume.
STREMIO_DATA_DIR=

# --- compose.vpn.yaml (gluetun, WireGuard) ------------------------------------------------------

# Your VPN provider's WireGuard private key. A secret: it belongs in .env only.
WIREGUARD_PRIVATE_KEY=

# The address your VPN provider assigned to this WireGuard peer.
WIREGUARD_ADDRESSES=
