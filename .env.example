# All values are optional. `docker compose up -d` works without a .env file.
# Copy this file to .env only when you want to override defaults.

IPADDRESS=192.168.1.254
STREMIO_DATA_DIR=stremio-cache
STREMIOSRV_BT_LISTEN_PORT=6881
CERT_FILE=certificates.pem
SERVER_URL=
TZ=Africa/Luanda

# Transactional update health validation timeout (seconds).
STREMIO_UPDATE_HEALTH_TIMEOUT=180

# Pi-hole Web Admin
PIHOLE_WEB_BIND_IP=0.0.0.0
PIHOLE_WEB_PORT=8053
PIHOLE_PASSWORD=
PIHOLE_UPSTREAM_DNS=1.1.1.1;1.0.0.1

# Optional LAN DNS exposure used only with compose.dns.yaml.
PIHOLE_DNS_BIND_IP=0.0.0.0
PIHOLE_DNS_PORT=53
